{
  "z0": "50",
  "omega": "2*pi*freq",
  "y0": "1/z0",

  "delta_s": "(1-s11)*(1-s22) - s12*s21 + 1e-30",
  "delta_s_y": "(1+s11)*(1+s22) - s12*s21 + 1e-30",
  "Z11": "z0 * ((1+s11)*(1-s22) + s12*s21) / delta_s",
  "Z12": "z0 * 2*s12 / delta_s",
  "Z21": "z0 * 2*s21 / delta_s",
  "Z22": "z0 * ((1-s11)*(1+s22) + s12*s21) / delta_s",
  "Y11": "y0 * ((1-s11)*(1+s22) + s12*s21) / delta_s_y",
  "Y12": "y0 * (-2*s12) / delta_s_y",
  "Y21": "y0 * (-2*s21) / delta_s_y",
  "Y22": "y0 * ((1+s11)*(1-s22) + s12*s21) / delta_s_y",
  "z_singlePort": "z0*(1+s11)/(1-s11)",
  "y_singlePort": "y0*(1-s11)/(1+s11)",
  "vswr": "(1+abs(s11))/(1-abs(s11))",
  "rl_db": "-db(s11)",
  "reZ11": "real(Z11)",
  "imZ11": "imag(Z11)",
  "reZ21": "real(Z21)",
  "imZ21": "imag(Z21)",
  "reZ12": "real(Z12)",
  "imZ12": "imag(Z12)",
  "reZ22": "real(Z22)",
  "imZ22": "imag(Z22)",
  "reY11": "real(Y11)",
  "imY11": "imag(Y11)",
  "reY21": "real(Y21)",
  "imY21": "imag(Y21)",
  "reY12": "real(Y12)",
  "imY12": "imag(Y12)",
  "reY22": "real(Y22)",
  "imY22": "imag(Y22)",

  "Z_ShuntConfig": "z0*s21/(2*(1-s21))",
  "Z_SeriesConfig": "z0*(1-s21)/s21",

  "imZ_ShuntConfig": "imag(Z_ShuntConfig)",
  "imZ_SeriesConfig": "imag(Z_SeriesConfig)",
  "indZ_ShuntConfig": "imZ_ShuntConfig/(omega)*1e9",
  "indZ_SeriesConfig": "imZ_SeriesConfig/(omega)*1e9",
  "capZ_ShuntConfig": "1/(imZ_ShuntConfig*omega)*1e12",
  "capZ_SeriesConfig": "1/(imZ_SeriesConfig*omega)*1e12"
  
}